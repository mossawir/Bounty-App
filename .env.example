# ---------------------------------------------------------------- API -------
# Leave this unset (or empty) to use the in-browser mock API.
# Set it to point the app at a real backend that implements docs/api-contract.md.
# VITE_API_BASE_URL=https://api.bugbazaar.example

# ------------------------------------------------------------- Monitoring ---
# Errors are POSTed here when set. Without it they stay in the in-memory buffer.
# VITE_ERROR_REPORT_URL=https://errors.bugbazaar.example/collect

# ----------------------------------------------------------------- Dev -------
# Show the "bug lab" error-trigger panel in a production build.
# VITE_ENABLE_DEVTOOLS=false
